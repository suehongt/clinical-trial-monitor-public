# ct-monitor 服务器环境配置样例
# 复制为 ct-monitor.env 后填写真实值；该文件含站点密码，
# 务必 chmod 600，且已被 .gitignore 排除，绝不入库。
#
# systemctl 上所有 ct-monitor-* 单元都会 source 这个文件。

# ── 运行模式与数据位置 ────────────────────────────────────────────
CT_MODE=production
CT_DB_PATH=/opt/ct-monitor/db/ct_monitor.db

# ── 站点访问口令（浏览器弹窗 Basic 认证）──────────────────────────
# 生成强密码：openssl rand -base64 18
CT_AUTH_USER=ctmon
CT_AUTH_PASSWORD=CHANGE-ME

# ── 公网只读模式（免登录演示站）──────────────────────────────────
# 设为 1 后：所有 GET 放行，全部写接口（含 sync / retry / live-check 等
# 触发爬取的端点）一律 403，仅放行两个浏览辅助端点（/api/search/interpret
# 与 /api/saved-searches/{id}/open）。适合关掉 Basic 认证直接公开访问的
# 演示站；自用/内网部署保持不设或 0。
#CT_PUBLIC_READONLY=1

# ── 邮件提醒（可选；要配就配全，只配一半会在启动时报错）────────────
#CT_EMAIL_SMTP_HOST=smtp.example.com
#CT_EMAIL_FROM=ct-monitor@example.com
#CT_EMAIL_SMTP_USER=ct-monitor@example.com
#CT_EMAIL_SMTP_PASSWORD=
#CT_EMAIL_SMTP_PORT=587
#CT_EMAIL_SMTP_STARTTLS=true
