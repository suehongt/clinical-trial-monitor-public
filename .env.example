# Shell environment example; this file is documentation, not automatically loaded.
CT_MODE=production
CT_DATA_DIR=/absolute/persistent/path/clinical-trial-monitor
# CT_DB_PATH=/absolute/path/to/existing-v19.db
CT_HOST=127.0.0.1
CT_PORT=8000
# Optional email delivery; leave all unset to disable SMTP.
# CT_EMAIL_SMTP_HOST=smtp.example.org
# CT_EMAIL_SMTP_PORT=587
# CT_EMAIL_SMTP_USER=
# CT_EMAIL_SMTP_PASSWORD=
# CT_EMAIL_SMTP_STARTTLS=true
# CT_EMAIL_FROM=monitor@example.org
# Optional collector controls.
# CT_DISEASE_PROFILE=mi
# CT_WAF_CHALLENGE_MODE=auto
# CT_WAF_PROXY_URL=
